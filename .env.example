# Copie para .env (que o git ignora) e preencha só o que você usa. Nunca suba o .env.

# Chrome: deixe vazio para o estúdio procurar sozinho (npm run doctor mostra o que achou)
CHROME_PATH=

# Voz e música (ElevenLabs): chave da SUA conta
ELEVENLABS_API_KEY=
# Voz da voz final (ElevenLabs > Voices > a voz > ID); usada por npm run video -- voz-final
ELEVENLABS_VOZ_ID=
